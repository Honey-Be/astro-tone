---
import 'toc-rail/style.css';
import '../styles/layouts/post.css';
import { type CollectionEntry, getCollection } from 'astro:content';
import Comments from '../components/Comments.astro';
import FeaturedPostGrid from '../components/FeaturedPostGrid.astro';
import FormattedDate from '../components/FormattedDate.astro';
import ImageLightbox from '../components/ImageLightbox.astro';
import ScrollFocus from '../components/ScrollFocus.astro';
import BaseLayout from './BaseLayout.astro';
import { SITE_AUTHOR, SITE_LANG, SITE_TITLE } from '../consts';
import { getUiText } from '../ui';
import { articleHref, type SeriesNav } from '../utils/articles';
import { withBase } from '../utils/paths';
import { serializeScriptJson } from '../utils/serialize-script-json';
import { slugify } from '../utils/slug';
import { categoryHref, getCategory } from '../utils/categories';

type Heading = { depth: number; slug: string; text: string };

type Props = CollectionEntry<'posts'>['data'] & {
  readingTime?: number;
  relatedPosts?: CollectionEntry<'posts'>[];
  seriesNav?: SeriesNav;
  headings?: Heading[];
};

const {
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
  readingTime,
  focusEffect,
  relatedPosts = [],
  category,
  tags = [],
  articleType = 'news',
  project,
  authors = [],
  series,
  seriesNav = {},
  headings = [],
  articleId,
} = Astro.props;

const tr = getUiText();
const articlesBase = withBase('/articles');

const [projectEntries, authorEntries] = await Promise.all([
  getCollection('projects'),
  getCollection('authors'),
]);
const projectEntry = project ? projectEntries.find((entry) => entry.id === project) : undefined;
const articleAuthors = authors
  .map((id) => authorEntries.find((entry) => entry.id === id))
  .filter((entry): entry is CollectionEntry<'authors'> => Boolean(entry));
const categoryNode = category ? getCategory(category) : undefined;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const pubDateISO = pubDate.toISOString();
const updatedDateISO = updatedDate?.toISOString();
// Composited title+meta card, not the hero photo — takes priority over `image`
// (heroImage) in BaseHead's OG resolution (see components/BaseHead.astro).
// BaseHead applies `withBase()` itself, so pass the raw path here.
const ogImageUrl = `/og/${articleId}.png`;

const jsonLd = serializeScriptJson({
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  datePublished: pubDateISO,
  ...(updatedDateISO && { dateModified: updatedDateISO }),
  url: canonicalURL.href,
  ...(heroImage && { image: new URL(heroImage.src, Astro.site).href }),
  author: { '@type': 'Person', name: SITE_AUTHOR },
  publisher: { '@type': 'Organization', name: SITE_TITLE },
  inLanguage: SITE_LANG,
});
---

<BaseLayout
  title={title}
  description={description}
  image={heroImage}
  ogImageUrl={ogImageUrl}
  type="article"
  pubDate={pubDateISO}
  updatedDate={updatedDateISO}
  bodyClass="post-page"
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={jsonLd} />
  </Fragment>

  {focusEffect && <ScrollFocus variant={focusEffect} />}

  <main id="main-content" class="post-main">
    <article data-pagefind-body>
      <a href={articlesBase} class="back-link">{tr.backLink}</a>

      <header class="post-header">
        <div class="post-accent"></div>
        {
          categoryNode && (
            <span class="sr-only" data-pagefind-meta="category">
              {categoryNode.label}
            </span>
          )
        }
        <div class="post-kicker">
          <span class:list={['post-type', `post-type--${articleType}`]}>
            {tr.articleType[articleType]}
          </span>
          {
            projectEntry && (
              <a class="post-project" href={withBase(`/projects/${projectEntry.id}/`)}>
                {projectEntry.data.title}
              </a>
            )
          }
        </div>
        <div class="post-meta">
          <FormattedDate class="meta-date" date={pubDate} />
          {
            readingTime && (
              <>
                <span class="dot">·</span>
                <span class="meta-item">{tr.readingTime(readingTime)}</span>
              </>
            )
          }
          {
            updatedDate && (
              <>
                <span class="dot">·</span>
                <span class="meta-updated">
                  {tr.updated} <FormattedDate date={updatedDate} />
                </span>
              </>
            )
          }
          {
            articleAuthors.length > 0 && (
              <>
                <span class="dot">·</span>
                <span class="meta-authors">
                  {articleAuthors.map((author, index) => (
                    <>
                      {index > 0 && ', '}
                      <a href={withBase(`/authors/${author.id}/`)}>{author.data.name}</a>
                    </>
                  ))}
                </span>
              </>
            )
          }
        </div>
        <h1 class="post-title" data-pagefind-meta="title">{title}</h1>
        {description && <p class="post-description">{description}</p>}
        {
          (categoryNode || tags.length > 0) && (
            <div class="post-terms" data-pagefind-ignore="all">
              {categoryNode && (
                <a class="post-term post-term--category" href={withBase(categoryHref(categoryNode.id))}>
                  {categoryNode.label}
                </a>
              )}
              {tags.map((tag) => (
                <a class="post-term post-term--tag" href={withBase(`/tags/${slugify(tag)}/`)}>
                  #{tag}
                </a>
              ))}
            </div>
          )
        }
      </header>

      <div class="post-divider"></div>

      {
        headings.length > 0 && (
          <nav class="inline-toc" aria-label={tr.toc} data-pagefind-ignore="all">
            <p class="inline-toc-label">{tr.toc}</p>
            <ol class="inline-toc-list">
              {headings.map((heading) => (
                <li class:list={['inline-toc-item', `inline-toc-item--depth-${heading.depth}`]}>
                  <a class="inline-toc-link" href={`#${heading.slug}`}>
                    {heading.text}
                  </a>
                </li>
              ))}
            </ol>
          </nav>
        )
      }

      <div class="prose" id="prose-content">
        <slot />
      </div>

      {
        series && (seriesNav.prev || seriesNav.next) && (
          <nav class="series-nav" aria-label={tr.series.label} data-pagefind-ignore="all">
            <p class="series-nav-label">
              {tr.series.label} · {series}
            </p>
            <div class="series-nav-links">
              {seriesNav.prev && (
                <a class="series-nav-link series-nav-link--prev" href={withBase(articleHref(seriesNav.prev))}>
                  <span class="series-nav-direction">{tr.series.prev}</span>
                  <span class="series-nav-title">{seriesNav.prev.data.title}</span>
                </a>
              )}
              {seriesNav.next && (
                <a class="series-nav-link series-nav-link--next" href={withBase(articleHref(seriesNav.next))}>
                  <span class="series-nav-direction">{tr.series.next}</span>
                  <span class="series-nav-title">{seriesNav.next.data.title}</span>
                </a>
              )}
            </div>
          </nav>
        )
      }

      {
        relatedPosts.length > 0 && (
          <section class="related-section" data-pagefind-ignore="all">
            <div class="related-header">
              <p class="related-label">{tr.relatedPosts}</p>
              <a href={articlesBase} class="related-view-all">
                {tr.allPosts}
              </a>
            </div>
            <FeaturedPostGrid posts={relatedPosts} variant="related" />
          </section>
        )
      }
    </article>
    <Comments />
  </main>
  <ImageLightbox />

  <script>
    import { onReady } from '../scripts/mount';
    import { mountReadingRailLoader } from '../scripts/reading-rail-loader';

    onReady(mountReadingRailLoader);
  </script>
</BaseLayout>
