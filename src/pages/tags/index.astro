---
import '../../styles/pages/posts-index.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getUiText } from '../../ui';
import { getVisibleArticles } from '../../utils/articles';
import { slugify } from '../../utils/slug';
import { withBase } from '../../utils/paths';

const articles = await getVisibleArticles();
const counts = new Map<string, number>();
for (const article of articles) {
  for (const tag of article.data.tags) {
    counts.set(tag, (counts.get(tag) ?? 0) + 1);
  }
}
const tags = [...counts.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
const tr = getUiText();
---

<BaseLayout title={tr.terms.tagsIndexTitle} description={tr.terms.tagsIndexDescription}>
  <main id="main-content" class="posts-main">
    <div class="posts-header">
      <div>
        <p class="posts-label eyebrow-accent">{tr.terms.tag}</p>
        <h1 class="posts-title">{tr.terms.tagsIndexTitle}</h1>
      </div>
    </div>

    <ul class="term-index-list">
      {
        tags.map(([name, count]) => (
          <li class="term-index-item">
            <a class="term-index-link" href={withBase(`/tags/${slugify(name)}/`)}>
              <span class="term-index-label">#{name}</span>
              <span class="term-index-count">{tr.terms.articleCount(count)}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </main>
</BaseLayout>
