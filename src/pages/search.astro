---
import '../styles/pages/search.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getUiText } from '../ui';
import { withBase } from '../utils/paths';

const tr = getUiText();
---

<BaseLayout title={tr.search.title} description={tr.search.inputLabel} robots="noindex, follow">
  <main id="main-content" class="search-main">
    <div class="search-header">
      <h1 class="search-title">{tr.search.title}</h1>
    </div>
    <div id="search" class="search-ui" aria-busy="true">
      <p class="search-loading" role="status">{tr.search.loading}</p>
      <noscript>
        <style>
          .search-loading {
            display: none;
          }
        </style>
        <p class="search-fallback">
          {tr.search.noscriptText} <a href={withBase('/articles/')}>{tr.search.archiveLinkLabel}</a>
        </p>
      </noscript>
    </div>
  </main>

  <script>
    import { onReady } from '../scripts/mount';
    import { mountSearchPage } from '../scripts/search-page';

    onReady(mountSearchPage);
  </script>
</BaseLayout>
