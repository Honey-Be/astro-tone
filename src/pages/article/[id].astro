---
import { render } from 'astro:content';
import readingTimeLib from 'reading-time';
import PostLayout from '../../layouts/PostLayout.astro';
import { getVisibleArticles, seriesNavFor, type Article, type SeriesNav } from '../../utils/articles';

export async function getStaticPaths() {
  const all = await getVisibleArticles();

  return all.map((article) => ({
    params: { id: String(article.data.articleId) },
    props: {
      post: article,
      relatedPosts: all
        .filter((p) => p.id !== article.id)
        .sort((a, b) => {
          const sameA = a.data.category && a.data.category === article.data.category ? 1 : 0;
          const sameB = b.data.category && b.data.category === article.data.category ? 1 : 0;
          if (sameA !== sameB) return sameB - sameA;
          return b.data.pubDate.valueOf() - a.data.pubDate.valueOf();
        })
        .slice(0, 3),
      seriesNav: seriesNavFor(article, all),
    },
  }));
}

interface Props {
  post: Article;
  relatedPosts: Article[];
  seriesNav: SeriesNav;
}

const { post, relatedPosts, seriesNav } = Astro.props;
const { Content, headings } = await render(post);
const tocHeadings = headings
  // `footnote-label` is the sr-only heading GFM auto-generates above the footnotes
  // section — not authored content, so it doesn't belong in the outline.
  .filter((heading) => (heading.depth === 2 || heading.depth === 3) && heading.slug !== 'footnote-label')
  // Astro's heading text includes the `rehypeAutolinkHeadings` "#" anchor content
  // (astro.config.mjs appends it as a text node), so strip it back off here.
  .map((heading) => ({ ...heading, text: heading.text.replace(/#\s*$/, '').trim() }));

const readingTime = Math.max(1, Math.round(readingTimeLib(post.body ?? '').minutes));
---

<PostLayout
  {...post.data}
  readingTime={readingTime}
  focusEffect={post.data.focusEffect}
  relatedPosts={relatedPosts}
  seriesNav={seriesNav}
  headings={tocHeadings}
>
  <Content />
</PostLayout>
